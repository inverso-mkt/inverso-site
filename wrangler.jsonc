{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inverso-site",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
