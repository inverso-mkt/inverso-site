{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inverso-site",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "DEPOIMENTOS", "id": "7a7a807667e043f5a7d477c26762373e" }
  ],
  "observability": { "enabled": true }
}
